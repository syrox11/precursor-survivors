{
  "name": "precursor-survivors",
  "version": "0.1.0",
  "private": true,
  "description": "Fan-made survivors-like game inspired by Jak and Daxter",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p tests/e2e",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:perf": "playwright test --grep @perf",
    "test:all": "vitest run && playwright test"
  },
  "license": "MIT",
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
